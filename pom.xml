<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openmrs.maven.parents</groupId>
        <artifactId>maven-parent-openmrs-module</artifactId>
        <version>2.3.0</version>
    </parent>

	<groupId>org.openmrs.module</groupId>
	<artifactId>metadataexport</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Metadata Export</name>
	<description>Exports metadata from a running OpenMRS instance as an Initializer-format configuration package</description>

	<url>https://github.com/openmrs/openmrs-module-metadataexport</url>

	<scm>
		<connection>scm:git:git@github.com:openmrs/openmrs-module-metadataexport.git</connection>
		<developerConnection>scm:git:git@github.com:openmrs/openmrs-module-metadataexport.git</developerConnection>
		<url>https://github.com/openmrs/openmrs-module-metadataexport/</url>
	  <tag>HEAD</tag>
  </scm>

	<modules>
		<module>api</module>
		<module>omod</module>
	</modules>

	<repositories>
		<repository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://mavenrepo.openmrs.org/public</url>
		</repository>
		<repository>
			<id>central</id>
			<name>Maven Repository Switchboard</name>
			<layout>default</layout>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://mavenrepo.openmrs.org/public</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

    <properties>
        <openmrsPlatformVersion>3.0.0-SNAPSHOT</openmrsPlatformVersion>
        <!-- keep the code formatter of the 2.x line so that spotless does not reformat untouched code -->
        <openmrsPlatformToolsVersion>2.8.3</openmrsPlatformToolsVersion>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <initializerVersion>3.0.0-SNAPSHOT</initializerVersion>
        <patientflagsVersion>4.0.0-SNAPSHOT</patientflagsVersion>
        <jacocoVersion>0.8.12</jacocoVersion>
        <emrapiVersion>4.0.0-SNAPSHOT</emrapiVersion>
        <fhir2Version>6.0.0-SNAPSHOT</fhir2Version>
        <idgenVersion>6.0.0-SNAPSHOT</idgenVersion>
        <metadatamappingVersion>3.0.0-SNAPSHOT</metadatamappingVersion>
        <metadatasharingVersion>1.2.2</metadatasharingVersion>
        <addresshierarchyVersion>4.0.0-SNAPSHOT</addresshierarchyVersion>
		<cohortModuleVersion>4.0.0-SNAPSHOT</cohortModuleVersion>
		<tasksVersion>3.0.0-SNAPSHOT</tasksVersion>
		<queueVersion>4.0.0-SNAPSHOT</queueVersion>
		<webservicesRestVersion>5.0.0-SNAPSHOT</webservicesRestVersion>
		<appointmentsVersion>3.0.0-SNAPSHOT</appointmentsVersion>
		<billingVersion>3.0.0-SNAPSHOT</billingVersion>
		<stockmanagementVersion>4.0.0-SNAPSHOT</stockmanagementVersion>
		<openmrsEventVersion>5.0.0-SNAPSHOT</openmrsEventVersion>
    </properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.openmrs</groupId>
				<artifactId>openmrs-bom</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacocoVersion}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.38</version>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>initializer-api</artifactId>
			<version>${initializerVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>patientflags-api</artifactId>
			<version>${patientflagsVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>emrapi-api</artifactId>
			<version>${emrapiVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>fhir2-api</artifactId>
			<version>${fhir2Version}</version>
			<scope>provided</scope>
			<exclusions>
				<exclusion>
					<groupId>com.google.guava</groupId>
					<artifactId>guava</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>idgen-api</artifactId>
			<version>${idgenVersion}</version>
			<scope>provided</scope>
			<exclusions>
				<exclusion>
					<groupId>org.apache.httpcomponents</groupId>
					<artifactId>httpclient</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>metadatamapping-api</artifactId>
			<version>${metadatamappingVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>metadatasharing-api-common</artifactId>
			<version>${metadatasharingVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>addresshierarchy-api</artifactId>
			<version>${addresshierarchyVersion}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>cohort-api</artifactId>
			<version>${cohortModuleVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>billing-api</artifactId>
			<version>${billingVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>stockmanagement-api</artifactId>
			<version>${stockmanagementVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs</groupId>
			<artifactId>event-api</artifactId>
			<version>${openmrsEventVersion}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>tasks-api</artifactId>
			<version>${tasksVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>queue-api</artifactId>
			<version>${queueVersion}</version>
			<scope>provided</scope>
		</dependency>
		<!-- Initializer's queues parser lives in its api-2.3 submodule; only the round-trip test needs it. -->
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>initializer-api-2.3</artifactId>
			<version>${initializerVersion}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.bahmni.module</groupId>
			<artifactId>appointments-api</artifactId>
			<version>${appointmentsVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>initializer-api-2.7</artifactId>
			<version>${initializerVersion}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
